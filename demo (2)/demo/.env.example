# Copie para .env na pasta demo (2)/demo e preencha suas credenciais.
DB_URL=jdbc:mysql://localhost:3306/moeda_estudantil?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=America/Sao_Paulo
DB_USER=root
DB_PASSWORD=

MAIL_PROVIDER=resend
RESEND_API_KEY=
# Para testes: onboarding@resend.dev. Producao: remetente de dominio verificado no Resend.
MAIL_FROM=onboarding@resend.dev
MAIL_DELIVERY_ENABLED=true
MAIL_TIMEOUT=10s
MAIL_POLL_INTERVAL_MS=1000

# Alternativa local: MAIL_PROVIDER=smtp, com Mailpit na porta 1025.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_AUTH=false
MAIL_STARTTLS=false
